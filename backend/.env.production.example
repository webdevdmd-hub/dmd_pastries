APP_ENV=production
PORT=8080
GIN_MODE=release
APP_NAME=pastries-pos-api

# NOTE: if the password contains special characters (@, :, /), percent-encode them
# in DATABASE_URL (e.g. "@" -> "%40") or psql and other clients will fail to parse it.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/dmd_pastries
POSTGRES_HOST=YOUR_DB_HOST
POSTGRES_PORT=5432
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=dmd_pastries
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

MIGRATIONS_PATH=migrations
AUTO_RUN_MIGRATIONS=false

APPWRITE_ENDPOINT=https://YOUR_APPWRITE_HOST/v1
APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
APPWRITE_API_KEY=YOUR_APPWRITE_SERVER_API_KEY

REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_URL=https://app.dmdpastries.com/reset-password
SUPER_ADMIN_ENABLED=true
SUPER_ADMIN_EMAILS=YOUR_SUPER_ADMIN_EMAIL

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://app.dmdpastries.com

DEFAULT_BUSINESS_CURRENCY=AED
DEFAULT_BUSINESS_TIMEZONE=Asia/Dubai
DEFAULT_TRIAL_DAYS=14
