# Copy this file to `.env` for local development.
# For Dokploy/production, use the values from `.env.production.example`
# inside the Dokploy environment variable panel.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<appwrite_project_id>
NEXT_PUBLIC_APPWRITE_PRODUCT_IMAGES_BUCKET_ID=<bucket_id>
NEXT_PUBLIC_APPWRITE_BUSINESS_ASSETS_BUCKET_ID=<bucket_id>
NEXT_PUBLIC_APPWRITE_USER_AVATARS_BUCKET_ID=<bucket_id>
NEXT_PUBLIC_APPWRITE_DOCUMENTS_BUCKET_ID=<bucket_id>
